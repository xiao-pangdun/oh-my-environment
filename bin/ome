#!/usr/bin/env zsh
# ome — oh-my-environment CLI (tool management)

set -euo pipefail

OME_HOME="${OME_HOME:-$HOME/.oh-my-environment}"
source "$OME_HOME/lib/log.zsh"
source "$OME_HOME/lib/path.zsh"

# --- Helpers ---

# Read disabled modules from .omerc
_ome_disabled_modules() {
  local disabled=()
  if [[ -f "$HOME/.omerc" ]]; then
    source "$HOME/.omerc"
    zstyle -a ':ome:modules' disabled disabled 2>/dev/null
  fi
  echo "${disabled[@]}"
}

# --- Commands ---

ome_cmd_install() {
  ome_info "Installing oh-my-environment..."

  local disabled=($(_ome_disabled_modules))
  local custom_dir="$OME_HOME/.custom"
  mkdir -p "$custom_dir/plugins"

  # Clean old module symlinks from .custom/
  local existing
  for existing in "$custom_dir"/*.zsh(N); do
    if [[ -L "$existing" ]]; then
      local link_target="$(readlink "$existing")"
      if [[ "$link_target" == *"$OME_HOME/modules"* ]]; then
        rm -f "$existing"
      fi
    fi
  done

  # Symlink module init.zsh files into .custom/
  local mod_dir mod_name
  for mod_dir in "$OME_HOME"/modules/*(N/); do
    mod_name="${mod_dir:t}"

    # Skip disabled modules
    if (( ${disabled[(Ie)$mod_name]} )); then
      ome_info "skipped (disabled): $mod_name"
      continue
    fi

    # Only symlink if module has init.zsh
    if [[ -f "$mod_dir/init.zsh" ]]; then
      ln -sf "$mod_dir/init.zsh" "$custom_dir/$mod_name.zsh"
      ome_info "enabled: $mod_name"
    fi
  done

  # Run module install.zsh files
  local install_file
  for install_file in "$OME_HOME"/modules/*/install.zsh(N); do
    source "$install_file"
  done

  ome_info "Install complete."
}

ome_cmd_update() {
  ome_info "Updating oh-my-environment..."

  # Update ome itself
  local output
  if output=$(git -C "$OME_HOME" pull --ff-only 2>&1); then
    if [[ "$output" != *"Already up to date"* ]]; then
      ome_info "oh-my-environment updated."
    else
      ome_info "oh-my-environment already up to date."
    fi
  else
    ome_warn "Failed to update ome: $output"
  fi

  # Update installed plugins
  local plugin_dir
  for plugin_dir in "$OME_HOME/.custom/plugins"/*(N/); do
    [[ -d "$plugin_dir/.git" ]] || continue
    local plugin_name="${plugin_dir:t}"
    if output=$(git -C "$plugin_dir" pull 2>&1); then
      if [[ "$output" != *"Already up to date"* ]]; then
        ome_info "Plugin updated: $plugin_name"
      fi
    else
      ome_warn "Failed to update plugin $plugin_name: $output"
    fi
  done

  # Re-install (re-symlink modules)
  ome_cmd_install

  ome_info "Update complete."
}

ome_cmd_uninstall() {
  # --- Phase 1: Build preview ---
  local -a symlinks_to_remove=() plain_leftovers=() modules_with_uninstall=() omc_backups=()
  local links_file target uninstall_file mod_name f

  for links_file in "$OME_HOME"/modules/*/links.conf(N); do
    while IFS= read -r target; do
      [[ "$target" =~ ^[[:space:]]*(#|$) ]] && continue
      target="${target## }"; target="${target%% }"
      target="${target/#\~/$HOME}"
      if [[ -L "$target" ]]; then
        symlinks_to_remove+=("$target")
      elif [[ -f "$target" || -d "$target" ]]; then
        plain_leftovers+=("$target")
      fi
    done < "$links_file"
  done

  for uninstall_file in "$OME_HOME"/modules/*/uninstall.zsh(N); do
    modules_with_uninstall+=("${uninstall_file:h:t}")
  done

  for f in "$HOME"/.zshrc.omc-backup*(N); do
    omc_backups+=("$f")
  done

  local config_exists=0
  [[ -d "$OME_HOME/.config" ]] && config_exists=1

  # --- Phase 2: Print preview, prompt ---
  ome_warn "About to uninstall oh-my-environment."
  echo ""
  if (( ${#modules_with_uninstall[@]} > 0 )); then
    echo "Will run module uninstall.zsh:"
    for mod_name in "${modules_with_uninstall[@]}"; do
      echo "  $mod_name"
    done
    echo ""
  fi
  echo "Will remove:"
  if (( ${#symlinks_to_remove[@]} > 0 )); then
    for target in "${symlinks_to_remove[@]}"; do
      echo "  $target (symlink)"
    done
  fi
  if (( ${#omc_backups[@]} > 0 )); then
    for f in "${omc_backups[@]}"; do
      echo "  $f"
    done
  fi
  echo "  $OME_HOME"
  echo ""
  if (( config_exists )); then
    echo "Will preserve (moved aside):"
    echo "  $OME_HOME/.config → ~/oh-my-environment-config/"
    echo ""
  fi
  if (( ${#plain_leftovers[@]} > 0 )); then
    echo "Will leave in place (plain files, possibly user-edited):"
    for target in "${plain_leftovers[@]}"; do
      echo "  $target"
    done
    echo ""
  fi
  echo "Will NOT touch:"
  echo "  ~/.oh-my-zsh   (manage omz separately)"
  echo "  ~/.zshrc       (your shell config — may still reference removed plugins)"
  echo "  ~/.omerc       (your config)"
  echo ""

  printf '\033[0;31m[ome]\033[0m Continue? [y/n] '
  read -r answer
  [[ "$answer" == [yY] ]] || { ome_info "Aborted."; return 0; }

  # --- Phase 3: Source uninstall.zsh files (before links.conf sweep) ---
  for uninstall_file in "$OME_HOME"/modules/*/uninstall.zsh(N); do
    source "$uninstall_file"
  done

  # --- Phase 4: Walk links.conf — remove symlinks, log plain files ---
  for links_file in "$OME_HOME"/modules/*/links.conf(N); do
    while IFS= read -r target; do
      [[ "$target" =~ ^[[:space:]]*(#|$) ]] && continue
      target="${target## }"; target="${target%% }"
      target="${target/#\~/$HOME}"
      if [[ -L "$target" ]]; then
        rm -f "$target"
        ome_info "Removed link: $target"
      elif [[ -f "$target" || -d "$target" ]]; then
        ome_info "Leftover plain file: $target — review and remove if not needed"
      fi
    done < "$links_file"
  done

  # --- Phase 5: Remove .zshrc.omc-backup* ---
  for f in "$HOME"/.zshrc.omc-backup*(N); do
    rm -f "$f"
    ome_info "Removed: $f"
  done

  # --- Phase 6: Preserve config repo ---
  if [[ -d "$OME_HOME/.config" ]]; then
    local dest="$HOME/oh-my-environment-config"
    if [[ -e "$dest" ]]; then
      dest="${dest}-$(date +%Y%m%d%H%M%S)"
    fi
    mv "$OME_HOME/.config" "$dest"
    ome_info "Preserved config repo at $dest"
    ome_info "  (If you had uncommitted/unpushed changes, sort them here.)"
  fi

  # --- Phase 7: Remove $OME_HOME ---
  if [[ -d "$OME_HOME" ]]; then
    rm -rf "$OME_HOME"
    ome_info "Removed $OME_HOME"
  fi

  # --- Phase 8: Final hints ---
  echo ""
  ome_info "Not removed:"
  ome_info "  ~/.oh-my-zsh — to remove omz: run uninstall_oh_my_zsh"
  ome_info "                or see https://github.com/ohmyzsh/ohmyzsh#uninstalling-oh-my-zsh"
  ome_info "  ~/.zshrc     — references plugins that are gone; clean up the plugins=() block manually"
  echo ""
  ome_info "Uninstall complete. Restart your shell."
}

# --- Dispatch ---

ome_help() {
  cat <<'EOF'
ome — oh-my-environment tool manager

Usage: ome <command>

Commands:
  install     Symlink modules into $ZSH_CUSTOM and run module setup
  update      Pull latest ome and update all installed plugins
  uninstall   Remove oh-my-environment, oh-my-zsh, and all linked configs

Config repo and plugins are managed by 'omc'.
EOF
}

case "${1:-}" in
  install)    ome_cmd_install ;;
  update)     ome_cmd_update ;;
  uninstall)  ome_cmd_uninstall ;;
  --help|-h|help|"")  ome_help ;;
  *)
    ome_error "Unknown command: $1"
    ome_help
    exit 1
    ;;
esac
